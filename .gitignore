# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
*.tsbuildinfo

# Runtime data — generated by the pipeline (kept out of source control).
# Anchored with a leading "/" so they only match at the repo root: a bare
# `assets/` also matched src/assets/ and silently kept source files out of git.
/.cache/
/output/
/assets/*
!/assets/.gitkeep
/projects/

# Secrets — NEVER commit real keys
.env
.env.local
.env.*.local

# Machine-specific npm cache mapping (written by the installer; absolute paths)
.npmrc

# Runtime data: usage counters, discovery review queue, IPC token (secret)
data/*
!data/.gitkeep
discovery-suggestions.json

# Remotion
remotion/out/
.remotion/

# Logs
*.log
npm-debug.log*
logs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
